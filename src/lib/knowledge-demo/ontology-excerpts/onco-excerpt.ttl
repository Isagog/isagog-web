kb:s-L3-allergia-penicillina a onco:AllergyStatement,
        onco:ClinicalStatement ;
    rdfs:label "Allergia a penicillina esclusa (de-labellazione)"@it ;
    onco:becauseOf kb:s-L3-test-allergologico-negativo ;
    onco:clinicallySalient true ;
    onco:concept <https://isagog.com/kb/paziente-esempio/concept/0a47fbe707> ;
    onco:date "2025-09-12"^^xsd:date ;
    onco:duringEncounter kb:E3 ;
    onco:extractionNote "Segnalazione di allergia delle precedenti lettere da considerarsi superata"@it ;
    onco:informationSource onco:SpecialistConsult ;
    onco:polarity onco:RuledOut ;
    onco:sourceDocument <https://isagog.com/kb/paziente-esempio/doc/L3> ;
    onco:sourceLineEnd 44 ;
    onco:sourceLineStart 44 ;
    onco:sourceQuote "Il paziente è stato **de-labellato**: può assumere beta-lattamici penicillinici. La segnalazione di allergia riportata nelle precedenti lettere di dimissione è pertanto da considerarsi **superata**."@it ;
    onco:subject kb:patient ;
    onco:supersedes kb:a-L1-penicillina,
        kb:a-L2-allergia-penicillina .

