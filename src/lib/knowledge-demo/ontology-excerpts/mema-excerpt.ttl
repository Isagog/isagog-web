# Excerpt from the MeMa / il manifesto ontology (Isagog client work).
# Class and property declarations only — the terms the demo displays.
# Instances shown in the demo are illustrative and are NOT from this file.

###  http://ilmanifesto.it/ontology#authored_by
:authored_by rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf ig:inherence ;
             rdfs:domain :Artwork ;
             rdfs:range ig:Person ;
             rdfs:label "autore"@it .

###  http://ilmanifesto.it/ontology#describes
:describes rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf ig:inherence ;
           rdfs:comment "Relates metadata or description to what it describes"@en ,
                        "Relazione tra metadati o descrizione e ciò che descrive"@it ;
           rdfs:label "describes"@en ,
                      "descrive"@it .

###  http://ilmanifesto.it/ontology#mentioned_in
:mentioned_in rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :relatedness ;
              owl:inverseOf :mentions ;
              rdfs:comment "Relates an entity to articles that mention it"@en ,
                           "Relazione tra un'entità e gli articoli che la menzionano"@it ;
              rdfs:label "mentioned in"@en ,
                         "menzionato in"@it .

###  http://ilmanifesto.it/ontology#mentions
:mentions rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :relatedness ;
          rdfs:range [ rdf:type owl:Class ;
                       owl:unionOf ( :Entity
                                     :Mention
                                   )
                     ] ;
          rdfs:comment "Referral to an entity, either direct or via a suitable reification (Mention)"@en ,
                       "Riferimento a un'entità, diretto o tramite una reificazione appropriata (Mention)"@it ;
          rdfs:label "mentions"@en ,
                     "menziona"@it ;
          owl:deprecated "not used" .

###  http://ilmanifesto.it/ontology#AIDescriptor
:AIDescriptor rdf:type owl:Class ;
              rdfs:subClassOf :EntityDescriptor ;
              rdfs:comment "Descrittore di entità generato da sistemi di IA"@it ,
                           "Entity descriptor generated by AI systems"@en ;
              rdfs:label "AI Descriptor"@en ,
                         "Descrittore IA"@it .

###  http://ilmanifesto.it/ontology#Article
:Article rdf:type owl:Class ;
         rdfs:subClassOf ig:Information ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :directus_id ;
                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:string
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :edition_date ;
                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:string
                         ] ,
                         _:genid12 ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :last_updated ;
                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:string
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :published_day ;
                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:string
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :signature ;
                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:string
                         ] ,
                         _:genid17 ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty ig:text ;
                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:string
                         ] ;
         rdfs:comment "Articolo di giornale o rivista"@it ,
                      "Newspaper or magazine article"@en ;
         rdfs:label "Article"@en ,
                    "Articolo"@it .

_:genid12 rdf:type owl:Restriction ;
           owl:onProperty :kicker ;
           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
           owl:onDataRange xsd:string .

_:genid17 rdf:type owl:Restriction ;
           owl:onProperty :title ;
           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
           owl:onDataRange xsd:string .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Article ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid12 ;
   :we_search "false"^^xsd:boolean ;
   :we_tok "FIELD"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Article ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid17 ;
   :we_search "false"^^xsd:boolean ;
   :we_tok "FIELD"
 ] .

###  http://ilmanifesto.it/ontology#Author
:Author rdf:type owl:Class ;
        rdfs:subClassOf ig:Person ;
        rdfs:comment "Authorship information, realized (but not necessarily) by some agent"@en ,
                     "Informazioni di autorship, realizzate (ma non necessariamente) da un agente"@it ;
        rdfs:label "Author"@en ,
                   "Autore"@it .

###  http://ilmanifesto.it/ontology#ContextualDescriptor
:ContextualDescriptor rdf:type owl:Class ;
                      rdfs:subClassOf :EntityDescriptor ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :derived_from ;
                                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass :Mention
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :valid_at ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTime
                                      ] ;
                      rdfs:comment "Descrizione di un'entità indicizzata temporalmente, così come caratterizzata al momento di una specifica menzione"@it ,
                                   "Time-indexed description of an entity as characterized at the moment of a specific mention"@en ;
                      rdfs:label "Contextual Descriptor"@en ,
                                 "Descrittore Contestuale"@it .

###  http://ilmanifesto.it/ontology#DBPediaDescriptor
:DBPediaDescriptor rdf:type owl:Class ;
                   rdfs:subClassOf :EntityDescriptor ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :dbpedia_ref ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ;
                   rdfs:comment "Descrittore di entità che riferisce risorse DBpedia"@it ,
                                "Entity descriptor referencing DBpedia resources"@en ;
                   rdfs:label "DBPedia Descriptor"@en ,
                              "Descrittore DBPedia"@it .

###  http://ilmanifesto.it/ontology#EntityDescriptor
:EntityDescriptor rdf:type owl:Class ;
                  rdfs:subClassOf ig:Information ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ig:referent ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :Entity
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ig:text ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:string
                                  ] ;
                  rdfs:comment "A sign that refers to an entity mentioned in articles"@en ,
                               "Un segno che si riferisce a un'entità menzionata negli articoli"@it ;
                  rdfs:label "Descrittore di Entità"@it ,
                             "Entity Descriptor"@en .

###  http://ilmanifesto.it/ontology#Fact
:Fact rdf:type owl:Class ;
      rdfs:subClassOf :Entity ,
                      ig:Event ;
      rdfs:comment "Eventi in quanto menzionati negli articoli"@it ,
                   "Events mentioned in articles"@en .

###  http://ilmanifesto.it/ontology#GeonamesDescriptor
:GeonamesDescriptor rdf:type owl:Class ;
                    rdfs:subClassOf :EntityDescriptor ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :geoinfo_name ;
                                      owl:someValuesFrom xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :geoinfo_id ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:integer
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :geoinfo_bbox ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :geoinfo_country_name ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :geoinfo_feature_class ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :geoinfo_feature_code ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :geoinfo_lat ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:double
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :geoinfo_lng ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:double
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :geoinfo_population ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:long
                                    ] ;
                    rdfs:comment "Descrittore di entità che riferisce il database geografico Geonames"@it ,
                                 "Entity descriptor referencing Geonames geographic database"@en ;
                    rdfs:label "Descrittore Geonames"@it ,
                               "Geonames Descriptor"@en .

###  http://ilmanifesto.it/ontology#HumanDescriptor
:HumanDescriptor rdf:type owl:Class ;
                 rdfs:subClassOf :EntityDescriptor ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :userid ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ;
                 rdfs:comment "Descrittore di entità creato da annotatori umani"@it ,
                              "Entity descriptor created by human annotators"@en ;
                 rdfs:label "Descrittore Umano"@it ,
                            "Human Descriptor"@en .

###  http://ilmanifesto.it/ontology#Mention
:Mention rdf:type owl:Class ;
         rdfs:subClassOf ig:Sign ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty ig:referent ;
                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Entity
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :mention_role ;
                           owl:someValuesFrom xsd:string
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :expression ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:string
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :description ;
                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:string
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :global_relevance ;
                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:int
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :mention_type ;
                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:string
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :reference_confidence ;
                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:decimal
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :typed_relevance ;
                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:int
                         ] ;
         rdfs:comment "A textual mention of an entity within a document with its context"@en ,
                      "Una menzione testuale di un'entità all'interno di un documento con il suo contesto"@it ;
         rdfs:label "Mention"@en ,
                    "Menzione"@it .

###  http://ilmanifesto.it/ontology#Topic
:Topic rdf:type owl:Class ;
       rdfs:subClassOf :Metadata ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :topic_of ;
                         owl:someValuesFrom :Article
                       ] ;
       rdfs:comment "Argomento rilevante di articolo identificato dalle funzioni redazionali o dall'IA"@it ,
                    "Relevant article topic identified by editorial functions or AI"@en ;
       rdfs:label "Argomento"@it ,
                  "Topic"@en .

###  http://ilmanifesto.it/ontology#WikipediaDescriptor
:WikipediaDescriptor rdf:type owl:Class ;
                     rdfs:subClassOf :EntityDescriptor ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :geoinfo_lat ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:double
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :geoinfo_lng ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:double
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :wiki_timestamp ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :wiki_title ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :wiki_url ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ;
                     rdfs:comment "Descrittore di entità che riferisce articoli Wikipedia"@it ,
                                  "Entity descriptor referencing Wikipedia articles"@en ;
                     rdfs:label "Descrittore Wikipedia"@it ,
                                "Wikipedia Descriptor"@en .
